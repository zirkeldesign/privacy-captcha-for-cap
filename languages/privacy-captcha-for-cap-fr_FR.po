msgstr "Embarqué : chargé depuis cette extension (recommandé, conforme au RGPD)"

#: src/Settings.php:403
msgid "Integrations"
msgstr "Intégrations"

#: src/Settings.php:410
msgid "Behavior"
msgstr "Comportement"

#: src/Settings.php:413
msgid "Fail-open mode"
msgstr "Mode tolérant (fail-open)"

#: src/Settings.php:417
msgid "Let submissions through when the Cap server is unreachable"
msgstr "Laisser passer les envois quand le serveur Cap est injoignable"

#: src/Settings.php:419
msgid "Off by default. Enable only if temporary Cap outages must not block legitimate users (logins, checkouts)."
msgstr "Désactivé par défaut. À activer seulement si une indisponibilité passagère de Cap ne doit pas bloquer les utilisateurs légitimes (connexions, commandes)."

#: src/Settings.php:424
msgid "Admin notices"
msgstr "Avertissements d’administration"

#: src/Settings.php:428
msgid "Warn site admins inline when an enabled integration is not configured"
msgstr "Avertir les administrateurs du site, directement dans la page, quand une intégration activée n’est pas configurée"

#: src/Settings.php:430
msgid "Only users with manage_options ever see these notices — anonymous visitors get nothing rendered."
msgstr "Seuls les utilisateurs disposant de manage_options voient ces avertissements, rien n’est affiché aux visiteurs anonymes."

