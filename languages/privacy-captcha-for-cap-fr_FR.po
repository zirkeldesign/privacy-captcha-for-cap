msgstr "Protéger les formulaires natifs de WordPress."

#: src/Settings.php:508
msgid "Form plugins"
msgstr "Extensions de formulaires"

#: src/Settings.php:509
msgid "Protect form-builder plugin submissions."
msgstr "Protéger les envois des extensions de création de formulaires."

#: src/Settings.php:513
#: src/Settings.php:554
