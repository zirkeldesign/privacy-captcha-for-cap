msgid "Status"
msgstr "État"

#: src/Settings.php:469
msgid "Refresh now"
msgstr "Actualiser maintenant"

#: src/Settings.php:470
msgid "Status is cached for 5 minutes."
msgstr "L’état est mis en cache pendant 5 minutes."

#: src/Settings.php:487
msgid "WordPress"
msgstr "WordPress"

#: src/Settings.php:488
msgid "Protect WordPress core forms."
msgstr "Protéger les formulaires natifs de WordPress."

#: src/Settings.php:492
msgid "Form plugins"
msgstr "Extensions de formulaires"

#: src/Settings.php:493
msgid "Protect form-builder plugin submissions."
msgstr "Protéger les envois des extensions de création de formulaires."

#: src/Settings.php:497
#: src/Settings.php:538
msgid "WooCommerce"
msgstr "WooCommerce"

#: src/Settings.php:498
msgid "Protect WooCommerce checkout and My Account forms."
msgstr "Protéger la commande WooCommerce et les formulaires Mon compte."

#: src/Settings.php:514
msgid "Adds a \"Privacy CAPTCHA for Cap\" field to the form editor under Advanced Fields."
msgstr "Ajoute un champ « Privacy CAPTCHA for Cap » dans l’éditeur de formulaire, sous Champs avancés."

#: src/Settings.php:518
msgid "Contact Form 7"
msgstr "Contact Form 7"

#: src/Settings.php:519
msgid "Protects every Contact Form 7 form submission."
msgstr "Protège tous les envois de formulaires Contact Form 7."

#: src/Settings.php:524
msgid "Protects the default WordPress comment form."
msgstr "Protège le formulaire de commentaire par défaut de WordPress."

#: src/Settings.php:529
msgid "Protects wp-login.php and any front-end login form using login_form."
msgstr "Protège wp-login.php et tout formulaire de connexion public utilisant login_form."

#: src/Settings.php:534
msgid "Protects the WordPress user registration form."
msgstr "Protège le formulaire d’inscription de WordPress."

#: src/Settings.php:539
msgid "Enable WooCommerce protection, then choose which forms below."
msgstr "Activez la protection WooCommerce, puis choisissez les formulaires ci-dessous."

#: src/Settings.php:543
msgid "Checkout"
msgstr "Commande"

#: src/Settings.php:544
msgid "Protects the WooCommerce checkout form."
msgstr "Protège le formulaire de commande WooCommerce."

#: src/Settings.php:548
msgid "Account login"
msgstr "Connexion au compte"

#: src/Settings.php:549
msgid "Protects the My Account login form."
msgstr "Protège le formulaire de connexion de Mon compte."

#: src/Settings.php:553
msgid "Account registration"
msgstr "Création de compte"

#: src/Settings.php:554
msgid "Protects the My Account registration form."
msgstr "Protège le formulaire d’inscription de Mon compte."

#: src/Settings.php:558
msgid "Lost password"
msgstr "Mot de passe perdu"

#: src/Settings.php:559
msgid "Protects the My Account lost-password form."
msgstr "Protège le formulaire de mot de passe perdu de Mon compte."

#: src/Settings.php:589
msgid "Plugin not active"
msgstr "Extension non active"

#: src/Settings.php:592
msgid "Options"
msgstr "Options"

#. translators: %s is the integration name, e.g. "Gravity Forms".
#: src/Settings.php:622
#, php-format
msgid "%s options"
msgstr "Options de %s"

#: src/Settings.php:658
msgid "Override fail-open per form"
msgstr "Remplacer le mode tolérant par formulaire"

#: src/Settings.php:667
msgid "Fail-open (let through if Cap is unreachable)"
msgstr "Tolérant (laisser passer si Cap est injoignable)"

#: src/Settings.php:668
msgid "Fail-closed (always require a valid proof)"
msgstr "Strict (toujours exiger une preuve valide)"

#: src/Settings.php:674
msgid "For example, let logins through during a Cap outage but always require a valid proof on contact forms."
msgstr "Par exemple, laisser passer les connexions pendant une indisponibilité de Cap, mais toujours exiger une preuve valide sur les formulaires de contact."

#: src/Settings.php:701
msgid "Automatic — protect every form (add the [cap_captcha] tag to a form for custom placement, or “cap_captcha: off” in its Additional Settings to skip it)"
msgstr "Automatique : protéger tous les formulaires (ajoutez la balise [cap_captcha] à un formulaire pour un placement personnalisé, ou « cap_captcha: off » dans ses Réglages additionnels pour l’exclure)"

#: src/Settings.php:705
msgid "Manual — only protect forms that contain the [cap_captcha] tag"
msgstr "Manuel : ne protéger que les formulaires contenant la balise [cap_captcha]"

#: src/Settings.php:708
msgid "Use Manual to keep the CAPTCHA off legally required or accessibility-sensitive forms."
msgstr "Utilisez le mode Manuel pour laisser le CAPTCHA à l’écart des formulaires légalement obligatoires ou sensibles en matière d’accessibilité."

#: src/Settings.php:717
msgid "Automatically protect every Gravity Form"
msgstr "Protéger automatiquement tous les formulaires Gravity Forms"

#: src/Settings.php:719
msgid "Otherwise add the “Privacy CAPTCHA for Cap” field to a form. Each form can override this under its own settings (Default / Always / Never)."
msgstr "Sinon, ajoutez le champ « Privacy CAPTCHA for Cap » à un formulaire. Chaque formulaire peut remplacer ce réglage dans ses propres options (Par défaut / Toujours / Jamais)."

#: src/Status/StatusPanel.php:39
msgid "Site"
msgstr "Site"

#: src/Status/StatusPanel.php:47
msgid "Challenges"
msgstr "Défis"

#: src/Status/StatusPanel.php:59
msgid "Failed"
msgstr "Échecs"

#: src/Status/StatusPanel.php:65
msgid "Avg. duration"
msgstr "Durée moy."

#. translators: %s is the latency in seconds with one decimal, e.g. "3.4 s"
#: src/Status/StatusPanel.php:67
#, php-format
msgid "%s s"
msgstr "%s s"

#: src/Status/StatusPanel.php:73
msgid "Difficulty"
msgstr "Difficulté"

#: src/Status/StatusPanel.php:152
msgid "Hourly solves chart"
msgstr "Graphique des résolutions par heure"

#. translators: 1: localized hour label, 2: verified-solve count
#: src/Status/StatusPanel.php:162
#, php-format
msgid "%1$s — %2$d verified"
msgstr "%1$s : %2$d vérifiés"

#: src/Settings.php:396
msgid "Cap server: load from your endpoint under /assets/"
msgstr "Serveur Cap : chargé depuis votre point de terminaison, sous /assets/"

#. translators: 1: site name, 2: site key, 3: challenge protocol, e.g. "hashwx"
#: src/Status/ConnectionCheck.php:51
#, php-format
msgid "Connected — site \"%1$s\" (%2$s), %3$s key"
msgstr "Connecté au site « %1$s » (%2$s), clé %3$s"

#. translators: 1: the connection message, 2: solver file name, e.g. "hashwx.wasm"
#: src/Status/ConnectionCheck.php:70
#, php-format
msgid "%1$s · %2$s served by the Cap server"
msgstr "%1$s · %2$s servi par le serveur Cap"

#. translators: 1: the connection message, 2: solver file name, 3: "HTTP 503" or "no response", 4: challenge protocol
#: src/Status/ConnectionCheck.php:78
#, php-format
msgid "%1$s, but the Cap server does not serve %2$s (%3$s). The widget cannot solve a %4$s challenge without it: enable the asset server on the Cap server with a WASM_VERSION that ships the file, or switch the WASM source to Bundled."
msgstr "%1$s, mais le serveur Cap ne sert pas %2$s (%3$s). Sans ce fichier, le widget ne peut pas résoudre un défi %4$s : activez le serveur d’assets du serveur Cap avec une WASM_VERSION qui contient le fichier, ou passez la source du WASM sur Embarqué."

#: src/Status/ConnectionCheck.php:82
msgid "no response"
msgstr "aucune réponse"

#. translators: %d: HTTP status code
#: src/Status/ConnectionCheck.php:84
#, php-format
msgid "HTTP %d"
msgstr "HTTP %d"

#: src/Status/StatusPanel.php:93
msgid "hashwx · expected hashes per solve"
msgstr "hashwx · hachages attendus par résolution"

#: src/Status/StatusPanel.php:94
msgid "rsw · time-lock squarings"
msgstr "rsw · itérations du verrou temporel"

#. translators: 1: challenge count, 2: salt size in bytes
#: src/Status/StatusPanel.php:97
#, php-format
msgid "sha256-pow · %1$d challenges · %2$d-byte salt"
msgstr "sha256-pow · %1$d défis · sel de %2$d octets"