msgstr "Ajoute un champ « Privacy CAPTCHA for Cap » dans l’éditeur de formulaire, sous Champs avancés."

#: src/Settings.php:534
msgid "Contact Form 7"
msgstr "Contact Form 7"

#: src/Settings.php:535
msgid "Protects every Contact Form 7 form submission."
msgstr "Protège tous les envois de formulaires Contact Form 7."

#: src/Settings.php:540
msgid "Protects the default WordPress comment form."
msgstr "Protège le formulaire de commentaire par défaut de WordPress."

#: src/Settings.php:545
msgid "Protects wp-login.php and any front-end login form using login_form."
msgstr "Protège wp-login.php et tout formulaire de connexion public utilisant login_form."

#: src/Settings.php:550
msgid "Protects the WordPress user registration form."
msgstr "Protège le formulaire d’inscription de WordPress."

#: src/Settings.php:555
msgid "Enable WooCommerce protection, then choose which forms below."
msgstr "Activez la protection WooCommerce, puis choisissez les formulaires ci-dessous."

#: src/Settings.php:559
msgid "Checkout"
msgstr "Commande"

#: src/Settings.php:560
msgid "Protects the WooCommerce checkout form."
msgstr "Protège le formulaire de commande WooCommerce."

#: src/Settings.php:564
msgid "Account login"
msgstr "Connexion au compte"

#: src/Settings.php:565
msgid "Protects the My Account login form."
msgstr "Protège le formulaire de connexion de Mon compte."

#: src/Settings.php:569
msgid "Account registration"
msgstr "Création de compte"

#: src/Settings.php:570
msgid "Protects the My Account registration form."
msgstr "Protège le formulaire d’inscription de Mon compte."

#: src/Settings.php:574
msgid "Lost password"
msgstr "Mot de passe perdu"

#: src/Settings.php:575
msgid "Protects the My Account lost-password form."
msgstr "Protège le formulaire de mot de passe perdu de Mon compte."

#: src/Settings.php:605
msgid "Plugin not active"
msgstr "Extension non active"

#: src/Settings.php:608
msgid "Options"
msgstr "Options"

#. translators: %s is the integration name, e.g. "Gravity Forms".
#: src/Settings.php:638
#, php-format
msgid "%s options"
msgstr "Options de %s"

#: src/Settings.php:674
msgid "Override fail-open per form"
msgstr "Remplacer le mode tolérant par formulaire"

#: src/Settings.php:683
msgid "Fail-open (let through if Cap is unreachable)"
msgstr "Tolérant (laisser passer si Cap est injoignable)"

#: src/Settings.php:684
msgid "Fail-closed (always require a valid proof)"
msgstr "Strict (toujours exiger une preuve valide)"

#: src/Settings.php:690
msgid "For example, let logins through during a Cap outage but always require a valid proof on contact forms."
msgstr "Par exemple, laisser passer les connexions pendant une indisponibilité de Cap, mais toujours exiger une preuve valide sur les formulaires de contact."

#: src/Settings.php:717
msgid "Automatic — protect every form (add the [cap_captcha] tag to a form for custom placement, or “cap_captcha: off” in its Additional Settings to skip it)"
msgstr "Automatique : protéger tous les formulaires (ajoutez la balise [cap_captcha] à un formulaire pour un placement personnalisé, ou « cap_captcha: off » dans ses Réglages additionnels pour l’exclure)"

#: src/Settings.php:721
msgid "Manual — only protect forms that contain the [cap_captcha] tag"
msgstr "Manuel : ne protéger que les formulaires contenant la balise [cap_captcha]"

#: src/Settings.php:724
msgid "Use Manual to keep the CAPTCHA off legally required or accessibility-sensitive forms."
msgstr "Utilisez le mode Manuel pour laisser le CAPTCHA à l’écart des formulaires légalement obligatoires ou sensibles en matière d’accessibilité."

#: src/Settings.php:733
msgid "Automatically protect every Gravity Form"
msgstr "Protéger automatiquement tous les formulaires Gravity Forms"

#: src/Settings.php:735
msgid "Otherwise add the “Privacy CAPTCHA for Cap” field to a form. Each form can override this under its own settings (Default / Always / Never)."
msgstr "Sinon, ajoutez le champ « Privacy CAPTCHA for Cap » à un formulaire. Chaque formulaire peut remplacer ce réglage dans ses propres options (Par défaut / Toujours / Jamais)."

