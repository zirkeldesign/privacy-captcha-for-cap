msgid "Per-form integrations can override this default."
msgstr "Les intégrations peuvent remplacer ce réglage formulaire par formulaire."

#: src/Settings.php:384
msgid "Privacy"
msgstr "Confidentialité"

#: src/Settings.php:387
msgid "WASM source"
msgstr "Source du WASM"

#: src/Settings.php:392
