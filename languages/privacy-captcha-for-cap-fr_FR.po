#: src/Settings.php:276
#, php-format
msgid "Connect WordPress to your self-hosted Cap server and choose which forms to protect. See %s for server setup."
msgstr "Connectez WordPress à votre serveur Cap auto-hébergé et choisissez les formulaires à protéger. Voir %s pour l’installation du serveur."

#: src/Settings.php:285
msgid "Cap server"
msgstr "Serveur Cap"

#: src/Settings.php:289
msgid "Endpoint base URL"
msgstr "URL de base du point de terminaison"

#: src/Settings.php:302
msgid "Defined via CAP_CAPTCHA_ENDPOINT in wp-config.php — value here is read-only."
msgstr "Définie via CAP_CAPTCHA_ENDPOINT dans wp-config.php, la valeur est ici en lecture seule."

#: src/Settings.php:304
msgid "Public URL of your Cap server, e.g. https://cap.example.com/"
msgstr "URL publique de votre serveur Cap, par exemple https://cap.example.com/"

#: src/Settings.php:311
msgid "Site key"
msgstr "Clé de site"

#: src/Settings.php:324
msgid "Defined via CAP_CAPTCHA_SITE_KEY in wp-config.php — value here is read-only."
msgstr "Définie via CAP_CAPTCHA_SITE_KEY dans wp-config.php, la valeur est ici en lecture seule."

#: src/Settings.php:326
msgid "Public site key issued by your Cap server."
msgstr "Clé de site publique délivrée par votre serveur Cap."

#: src/Settings.php:333
msgid "Secret key"
msgstr "Clé secrète"

#: src/Settings.php:346
msgid "Defined via CAP_CAPTCHA_SECRET_KEY in wp-config.php — value here is read-only."
msgstr "Définie via CAP_CAPTCHA_SECRET_KEY dans wp-config.php, la valeur est ici en lecture seule."

#: src/Settings.php:348
msgid "Secret key used to call /siteverify. Define CAP_CAPTCHA_SECRET_KEY in wp-config.php to override."
msgstr "Clé secrète utilisée pour appeler /siteverify. Définissez CAP_CAPTCHA_SECRET_KEY dans wp-config.php pour la remplacer."

#: src/Settings.php:355
msgid "Admin API key"
msgstr "Clé d’API admin"

#: src/Settings.php:368
msgid "Defined via CAP_CAPTCHA_ADMIN_API_KEY in wp-config.php — value here is read-only."
msgstr "Définie via CAP_CAPTCHA_ADMIN_API_KEY dans wp-config.php, la valeur est ici en lecture seule."

#: src/Settings.php:370
msgid "Optional. Issue a dedicated key under Settings → API Keys in your Cap server and paste it here. Used for the Status panel below. Define CAP_CAPTCHA_ADMIN_API_KEY in wp-config.php to override."
msgstr "Facultatif. Créez une clé dédiée dans Settings → API Keys sur votre serveur Cap et collez-la ici. Elle alimente le panneau État ci-dessous. Définissez CAP_CAPTCHA_ADMIN_API_KEY dans wp-config.php pour la remplacer."

